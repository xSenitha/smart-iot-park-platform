# ==============================================================================
# Smart IoT Park Platform - Environment Configuration Template
# Copy this file to .env for local development. Never commit .env to version control!
# ==============================================================================

# General Platform Settings
PLATFORM_ENV=development
PLATFORM_NAME=smart-iot-park-platform
LOG_LEVEL=INFO

# Networking & Gateway
GATEWAY_PORT=8080
GATEWAY_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_PORT=3000

# Security & Authentication (Change in production!)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# Core API (Spring Boot 3 + Java 21)
CORE_API_PORT=8081
CORE_API_URL=http://core-api:8081

# MySQL Database (Structured Relational Storage)
MYSQL_HOST=mysql
MYSQL_PORT=3307
MYSQL_DATABASE=smartpark_db
MYSQL_USER=smartpark_user
MYSQL_PASSWORD=smartpark_dev_pass
MYSQL_ROOT_PASSWORD=smartpark_root_dev_pass

# Ingestion Service (Spring Boot + Reactive Mongo + MQTT)
INGESTION_SERVICE_PORT=8082
INGESTION_SERVICE_URL=http://ingestion-service:8082

# MongoDB Database (High-throughput Telemetry & Predictions)
MONGO_HOST=mongodb
MONGO_PORT=27018
MONGO_DATABASE=smartpark_telemetry
MONGO_USER=mongo_user
MONGO_PASSWORD=mongo_dev_pass
MONGO_INITDB_ROOT_USERNAME=mongo_admin
MONGO_INITDB_ROOT_PASSWORD=mongo_root_pass

# MQTT Broker (Eclipse Mosquitto)
MQTT_BROKER_HOST=mosquitto
MQTT_BROKER_PORT=1883
MQTT_CLIENT_ID=smartpark-ingestion-consumer
MQTT_TELEMETRY_TOPIC_FILTER=parks/+/zones/+/devices/+/telemetry

# AI Engine (FastAPI + Python 3.12)
AI_ENGINE_PORT=8083
AI_ENGINE_URL=http://ai-engine:8083
AI_PREDICTION_CRON_INTERVAL_MINUTES=5
BIN_OVERFLOW_WARNING_HOURS=3.0
EQUIPMENT_ANOMALY_THRESHOLD=0.75
SOIL_MOISTURE_CRITICAL_DEFICIT=20.0

# Sensor Simulator
SIMULATOR_INTERVAL_SECONDS=10
SIMULATOR_MQTT_ENABLED=true
SIMULATOR_REST_ENABLED=false
SIMULATOR_ANOMALY_RATE=0.08
SIMULATOR_PARK_ID=1

# Observability (Prometheus & Grafana)
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# AWS Deployment (Terraform)
AWS_REGION=us-east-1
AWS_ENVIRONMENT=production
AWS_INSTANCE_TYPE=t3.large
